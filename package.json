{
  "name": "ascenda",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "echo 'Run supabase/schema.sql and supabase/seed.sql via Supabase SQL editor'",
    "seed:students": "tsx --tsconfig tsconfig.json scripts/seed-students.ts",
    "db:apply": "tsx --tsconfig tsconfig.json scripts/apply-sql.ts",
    "supabase:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public,storage > src/lib/types/database.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.49.0",
    "@hookform/resolvers": "3.3.4",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.0",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-query-devtools": "5.90.2",
    "@tiptap/extension-character-count": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.0",
    "date-fns": "3.3.1",
    "framer-motion": "^12.23.24",
    "lenis": "1.3.25",
    "lucide-react": "0.577.0",
    "next": "^15.5.21",
    "openai": "^6.34.0",
    "papaparse": "5.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.2.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.11",
    "@types/node": "20.11.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.16",
    "baseline-browser-mapping": "^2.10.19",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.23",
    "tailwindcss": "3.3.5",
    "ts-jest": "29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "5.3.3"
  }
}
