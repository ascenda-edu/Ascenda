SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=application-documents
SUPABASE_PROJECT_ID=

# Demo user (student demo account discriminator; defaults to the seeded demo email)
NEXT_PUBLIC_DEMO_EMAIL=greg@workiflow.com

# Seed/demo account passwords. Required by the seed scripts and the docs
# generators — each fails fast when unset, and NO default is provided on purpose:
# these open real accounts on the live project, so a fallback value in the repo
# is a committed credential. Never fill these in here; set them locally only.
DEMO_USER_PASSWORD=
SEED_STUDENT_PASSWORD=

# ---------------------------------------------------------------------------
# Everything below was read by code but documented nowhere until src/lib/env.ts
# was introduced. The schema in that file is now the source of truth: it lists
# every variable the app reads, marks it required or optional, and explains why.
#
# ONLY NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are required.
# Everything else degrades to a documented, non-fatal behaviour when unset.
# src/instrumentation.ts validates the whole set once at server startup.
# ---------------------------------------------------------------------------

# Google Gemini. Powers /api/chat, /api/essay-assist and the agentic chat
# actions. Unset ⇒ those routes return 503 "AI service not configured"; the rest
# of the app is unaffected. Not required at build time, so CI stays green — but
# it IS required in production, and instrumentation.ts warns loudly at boot.
GEMINI_API_KEY=

# Bearer token for the server-to-server path into
# /api/admin/catalog-health (CLI/cron). Unset is SAFE: the bearer check simply
# never matches and the route falls back to requiring an authenticated admin.
ADMIN_API_KEY=

# Optional analytics sink. lib/analytics.ts POSTs events here when set and is a
# complete no-op otherwise — which is the current production behaviour.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Catalogue visibility overrides (lib/catalog/visibility.ts). Comma-separated
# programme ids. All three are optional; each has an in-code default.
NEXT_PUBLIC_FLAGGED_PROGRAM_IDS=
NEXT_PUBLIC_DEMO_PROGRAM_IDS=
DEMO_PROGRAM_IDS=

# Set to 1 for verbose matching diagnostics (lib/matching/service.ts).
MATCH_DEBUG=

# Minimum level emitted by lib/observability/logger.ts:
# debug | info | warn | error. Defaults to debug outside production, info in it.
LOG_LEVEL=

# Overrides the seeded demo profile id used by scripts/seed-demo-user.ts.
DEMO_USER_ID=

# Optional read-only calendar feeds surfaced by /api/calendar-feed. Each feed is
# independent — an unset variable means that source is simply not offered.
GOOGLE_CALENDAR_FEED_URL=
OUTLOOK_CALENDAR_FEED_URL=
CUSTOM_ICS_FEED_URL=

# Phantom variable, kept only so the drift is visible rather than silent: it is
# set in .github/workflows/ci.yml and listed in CLAUDE.md, and read by NO code
# anywhere in src/ or scripts/ (verified). Safe to delete from CI and CLAUDE.md.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
